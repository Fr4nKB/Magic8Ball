<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required to access Glyph interface -->
    <uses-permission android:name="com.nothing.ketchum.permission.ENABLE"/>

    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH"/>
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/glyph_toy_magicball"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true">

        <service android:name="com.frank.magic8ball.ToyService"
            android:exported="true"
            android:foregroundServiceType="health">

            <intent-filter>
                <action android:name="com.nothing.glyph.TOY"/>
            </intent-filter>

            <!-- Required, otherwise your toy will not be display in manager list -->
            <meta-data
                android:name="com.nothing.glyph.toy.name"
                android:resource="@string/glyph_toy_magicball"/>

            <!-- Required, allows users to preview your toy -->
            <meta-data
                android:name="com.nothing.glyph.toy.image"
                android:resource="@drawable/magic_8ball_preview"/>

            <!-- Optional, Briefly describe your toy in one sentence -->
            <meta-data
                android:name="com.nothing.glyph.toy.summary"
                android:resource="@string/glyph_toy_magicball_summary" />

            <!-- Optional, Activate long press -->
            <meta-data
                android:name="com.nothing.glyph.toy.longpress"
                android:value="1" />

        </service>

    </application>

</manifest>